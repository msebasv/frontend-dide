# Sitio SharePoint del ambiente activo (QA o PRE).
# Debe coincidir con el sitio del power.config.json en uso.
VITE_SHAREPOINT_SITE_URL=https://unbosqueeduco.sharepoint.com/sites/quality-sharedpoint-academicplus-dide

# Biblioteca de documentos (opcional; por defecto Shared Documents)
VITE_SHAREPOINT_LIBRARY=Shared Documents

# Carpeta de formatos dentro de la biblioteca (opcional; por defecto Formats)
VITE_SHAREPOINT_FORMATS_FOLDER=Formats
